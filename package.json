{
  "name": "afrodita",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/asset-pipeline/copy-wasm.mjs && node scripts/asset-pipeline/copy-draco.mjs && next dev",
    "build": "node scripts/asset-pipeline/copy-wasm.mjs && node scripts/asset-pipeline/copy-draco.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "prisma generate",
    "assets:wasm": "node scripts/asset-pipeline/copy-wasm.mjs",
    "assets:draco": "node scripts/asset-pipeline/copy-draco.mjs",
    "assets:retopo": "blender --background --python scripts/asset-pipeline/01-retopo.py --",
    "assets:rig": "blender --background --python scripts/asset-pipeline/02-rig.py --",
    "assets:lods": "node scripts/asset-pipeline/03-lods.mjs",
    "assets:validate": "node scripts/asset-pipeline/04-validate.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-query": "^5.102.8",
    "@types/three": "^0.186.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.26.0",
    "sileo": "^0.1.5",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.2.2"
}
