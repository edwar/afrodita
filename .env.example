# Site URL pública (Vercel: producción/preview la inyectan automáticamente)
# NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"

# Database (Neon)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="your-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# AI Providers (al menos uno requerido)
# Gemini: estilista (chat) y probador (generación de imágenes). El probador
# necesita una key con acceso al modelo de imagen; cada look generado se cobra.
GEMINI_API_KEY="your-gemini-key"
# Opcional: modelo de imagen del probador (por defecto gemini-3.1-flash-image)
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
# Opcional: "512" genera imágenes más pequeñas (~25% más baratas, menos nítidas)
# GEMINI_IMAGE_SIZE="512"
# Opcional: modelo que revisa la foto base antes de guardarla (por defecto, el del chat)
# GEMINI_MODERATION_MODEL="gemini-3.8-flash"
# Opcional: fotos que se revisan por usuario y día (por defecto 15)
# PHOTO_CHECK_DAILY_LIMIT="15"
# Opcional: máximo de looks generados por usuario y día (por defecto 20)
# TRYON_DAILY_LIMIT="20"
# Producción (opcional)
OPENAI_API_KEY="your-openai-key"
ANTHROPIC_API_KEY="your-anthropic-key"

# Correo de contacto que se publica en los términos y la política de seguridad
# (solicitudes sobre datos, reportes). Si se deja vacío, esa sección se omite.
NEXT_PUBLIC_CONTACT_EMAIL="contacto@tu-dominio.com"

# Entrar con Google (opcional). Crea un "ID de cliente de OAuth" tipo Web en
# https://console.cloud.google.com/apis/credentials y añade como URI de
# redirección: <BETTER_AUTH_URL>/api/auth/callback/google (y la de localhost).
# Sin estas dos variables el botón de Google no aparece.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend (Email)
RESEND_API_KEY="re_xxxxxxxxxx"

# Vercel Blob (File Storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_xxxxxxxxxx"

# Neon Object Storage (inyectado por `neon link` - bucket wardrobe-images)
AWS_ACCESS_KEY_ID="nak_live_xxxx"
AWS_SECRET_ACCESS_KEY="xxxx"
AWS_ENDPOINT_URL_S3="https://xxx.storage.neon.tech"
AWS_REGION="us-east-2"
