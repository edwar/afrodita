# Site URL pública (Vercel: producción/preview la inyectan automáticamente)
# NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"

# Database (Neon)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="your-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# AI Providers (al menos uno requerido)
# MVP: Gemini (gratis)
GEMINI_API_KEY="your-gemini-key"
# Producción (opcional)
OPENAI_API_KEY="your-openai-key"
ANTHROPIC_API_KEY="your-anthropic-key"

# Resend (Email)
RESEND_API_KEY="re_xxxxxxxxxx"

# Vercel Blob (File Storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_xxxxxxxxxx"

# Image-to-3D (al menos uno requerido para probador 3D)
TRIPO_API_KEY="your-tripo-key"
MESHY_API_KEY="your-meshy-key"

# Neon Object Storage (inyectado por `neon link` - bucket wardrobe-images)
AWS_ACCESS_KEY_ID="nak_live_xxxx"
AWS_SECRET_ACCESS_KEY="xxxx"
AWS_ENDPOINT_URL_S3="https://xxx.storage.neon.tech"
AWS_REGION="us-east-2"
